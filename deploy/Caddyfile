# /etc/caddy/Caddyfile
109-123-252-126.sslip.io {
	@public path /login /callback /paid /webhooks/dodo /api/*
	handle @public {
		reverse_proxy 127.0.0.1:8092
	}
	# Versión web y apps móviles: el reproductor conecta aquí por wss://.
	handle /ws {
		reverse_proxy 127.0.0.1:8090
	}
	handle {
		root * /srv/mestisexo/web
		header {
			Cache-Control "no-cache"
			Referrer-Policy "no-referrer"
			X-Content-Type-Options "nosniff"
			Content-Security-Policy "default-src 'self'; connect-src 'self' wss://109-123-252-126.sslip.io; media-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data:; frame-ancestors 'none'"
		}
		file_server
	}
}
