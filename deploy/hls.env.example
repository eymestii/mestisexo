# /etc/mestisexo/hls.env  (root:root, permisos 600)
# Clave con la que el servicio de cuentas firma el acceso al vídeo y el
# repetidor lo valida. La leen los dos, así que va en un fichero aparte:
# el repetidor no tiene por qué ver las claves de Discord ni las de pagos.
#
# Mínimo 32 caracteres. Genera una con:
#   openssl rand -base64 48
# Si cambias la clave, reinicia los dos servicios a la vez; mientras no
# coincidan, nadie puede ver el vídeo.
HLS_SECRET=
