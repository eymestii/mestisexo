# /etc/mestisexo/auth.env  (root:root, permisos 600)
# Dirección pública HTTPS (Caddy la sirve con Let's Encrypt).
PUBLIC_URL=https://109-123-252-126.sslip.io

# Discord: https://discord.com/developers/applications
# Redirect de OAuth2: https://109-123-252-126.sslip.io/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_SUB_ROLE_ID=
# Invitación que se muestra a quien no está en el servidor (opcional).
DISCORD_INVITE=

# Dodo Payments (vacío = pagos desactivados). DODO_MODE=test o live.
# Webhook: https://109-123-252-126.sslip.io/webhooks/dodo
DODO_MODE=test
DODO_API_KEY=
DODO_WEBHOOK_SECRET=
DODO_PRODUCT_ID=
