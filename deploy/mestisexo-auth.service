[Unit]
Description=Mestisexo: cuentas de Discord y suscripciones
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/mestisexo-auth
EnvironmentFile=/etc/mestisexo/auth.env
# Clave compartida con el repetidor para firmar el acceso al vídeo.
EnvironmentFile=-/etc/mestisexo/hls.env
Restart=always
RestartSec=2
DynamicUser=yes
StateDirectory=mestisexo-auth
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_INET AF_INET6
MemoryMax=128M

[Install]
WantedBy=multi-user.target
