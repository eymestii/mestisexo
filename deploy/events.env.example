# /etc/mestisexo/events.env  (root:root, permisos 600)
# Token con el que el bot de avisos se conecta a /events del repetidor. Lo
# leen el repetidor y mestisexo-notify, así que va en un fichero aparte.
#
# Mínimo 32 caracteres. Genera uno con:
#   openssl rand -hex 32
# Si falta o es corto, el repetidor arranca igual pero sin avisos.
EVENTS_TOKEN=
