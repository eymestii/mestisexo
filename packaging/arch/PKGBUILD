# Módulo del streamer para Arch Linux. Compila desde este repositorio:
#   cd packaging/arch && makepkg -si
pkgname=mestisexo
pkgver=0.7.2
pkgrel=1
pkgdesc="Streamer de Mestisexo: recibe OBS y lo envía al VPS"
arch=(x86_64)
license=(custom)
depends=(webkit2gtk-4.1 gst-plugins-base gst-plugins-good gst-libav ffmpeg openssh)
makedepends=(rust npm)
options=(!lto !debug)

build() {
  cd "$startdir/../../ui"
  npm ci
  npm run build
  cd ..
  cargo build --release --locked -p mestisexo --target-dir "$srcdir/target"
}

package() {
  cd "$startdir/../.."
  install -Dm755 "$srcdir/target/release/mestisexo" "$pkgdir/usr/bin/mestisexo"
  install -Dm644 app/icons/128x128.png "$pkgdir/usr/share/icons/hicolor/128x128/apps/mestisexo.png"
  install -Dm644 packaging/arch/mestisexo.desktop "$pkgdir/usr/share/applications/mestisexo.desktop"
}
